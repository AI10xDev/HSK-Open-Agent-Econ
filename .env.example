# --- HSKChain testnet -------------------------------------------------
# RPC + chain id are fixed by the network (verified: eth_chainId == 0x85)
HSK_RPC_URL=https://testnet.hsk.xyz
HSK_CHAIN_ID=133

# --- API -------------------------------------------------------------
# Host+port clients connect to. Part of the signed conditions, so changing
# this invalidates any in-flight challenge.
HSK_DOMAIN=localhost:5000
# The endpoint the token unlocks.
HSK_URI=/api/v1/data

# REQUIRED in production. Without it a random secret is generated at boot and
# every restart invalidates outstanding tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HSK_TOKEN_SECRET=

# How long a minted token and a challenge stay valid, in seconds.
HSK_TOKEN_TTL=900
HSK_MESSAGE_TTL=300

# Comma-separated allowlist. Empty = anyone with a valid signature is allowed.
# HSK_ALLOWED_ADDRESSES=0xYourChecksummedAddress

# Require the signer to have an on-chain footprint on the testnet, i.e. an
# account the faucet has actually funded. Off by default.
HSK_REQUIRE_ONCHAIN=false
# Make an RPC outage deny sign-in instead of skipping the on-chain check.
HSK_ONCHAIN_FATAL=false

# Persist nonces so they survive restarts and extra workers. Without this,
# in-memory nonces are lost on restart (fail-closed) and gunicorn must run a
# single worker.
# HSK_NONCE_STORE=./var/nonces.json

# --- Faucet ----------------------------------------------------------
# The client ships the public HMAC credentials the faucet web app uses; only
# override these if the operator gave you your own key.
HSK_FAUCET_API_URL=https://faucet-api.hashkeychain.net
# HSK_FAUCET_HMAC_USERNAME=faucet
# HSK_FAUCET_HMAC_SECRET=

# A reCAPTCHA v2 token solved by a human at https://faucet.hsk.xyz/faucet.
# Only a human can obtain this; nothing here solves or bypasses the challenge.
# HSK_RECAPTCHA_TOKEN=

# --- Misc ------------------------------------------------------------
PORT=5000
HSK_WALLET_FILE=wallet.json
