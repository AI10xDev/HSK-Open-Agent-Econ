# --- Network (the most important setting) ---------------------------------
# Which HSKChain network this deployment talks to. Everything chain-dependent
# follows from it: the conditioned message's chainId and wording, the RPC probe,
# and the chain condition the verifier enforces.
#
#   mainnet -> chain 177, https://mainnet.hsk.xyz, hashkey.blockscout.com
#   testnet -> chain 133, https://testnet.hsk.xyz, testnet-explorer.hsk.xyz
#
# The faucet only exists on testnet; there is no mainnet faucet.
HSK_NETWORK=mainnet

# RPC + chain id are fixed by the network (mainnet verified: eth_chainId == 0xb1).
# Normally leave HSK_CHAIN_ID unset so it tracks HSK_NETWORK. If you set it and it
# disagrees with the selected network, the service refuses to start rather than
# verifying against the wrong chain.
# HSK_RPC_URL=https://mainnet.hsk.xyz
# HSK_CHAIN_ID=177

# Seconds to wait on the RPC. The /api/v1/network probe uses this; the data
# endpoint always uses at most 3s so a slow node cannot stall a request.
# HSK_RPC_TIMEOUT=15

# --- API -----------------------------------------------------------------
# Host+port clients connect to. Part of the signed conditions, so changing
# this invalidates any in-flight challenge.
HSK_DOMAIN=localhost:5000
# The endpoint the token unlocks.
HSK_URI=/api/v1/data

# REQUIRED in production. Without it, a random secret is generated at boot and
# every restart invalidates outstanding tokens. On mainnet this is enforced
# (the service will not start without it); set HSK_PRODUCTION=false to opt out
# for local experiments. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HSK_TOKEN_SECRET=

# Treat this as production: require HSK_TOKEN_SECRET regardless of network.
# Defaults to true on mainnet, false on testnet.
# HSK_PRODUCTION=true

# How long a minted token and a challenge stay valid, in seconds.
HSK_TOKEN_TTL=900
HSK_MESSAGE_TTL=300

# Comma-separated allowlist. Empty = anyone with a valid signature is allowed.
# Strongly recommended on a public mainnet deployment.
# HSK_ALLOWED_ADDRESSES=0xYourChecksummedAddress

# Require the signer to have an on-chain footprint, i.e. an account that has
# actually been used on the selected chain (non-zero nonce or balance, or
# deployed code). On testnet this is effectively "the faucet funded it"; on
# mainnet it means "this account is not brand new". Off by default.
HSK_REQUIRE_ONCHAIN=false
# Make an RPC outage deny sign-in instead of skipping the on-chain check.
HSK_ONCHAIN_FATAL=false

# Persist nonces so they survive restarts and extra workers. Without this,
# in-memory nonces are lost on restart (fail-closed) and gunicorn must run a
# single worker.
# HSK_NONCE_STORE=./var/nonces.json

# GET /api/v1/session returns only your own session unless this is on, in which
# case it also returns every session on the instance. That list contains other
# users' addresses, so leave it off for anything public.
# HSK_EXPOSE_SESSION_LIST=false

# --- Faucet (TESTNET ONLY) -------------------------------------------------
# The official faucet has no mainnet deployment. The client refuses to run
# against a non-testnet network, and these settings are only consulted when
# HSK_NETWORK=testnet.
HSK_FAUCET_API_URL=https://faucet-api.hashkeychain.net
# HSK_FAUCET_HMAC_USERNAME=faucet
# HSK_FAUCET_HMAC_SECRET=

# A reCAPTCHA v2 token solved by a human at https://faucet.hsk.xyz/faucet.
# Only a human can obtain this; nothing here solves or bypasses the challenge.
# HSK_RECAPTCHA_TOKEN=

# --- Misc ---------------------------------------------------------------
# Bind address for `python app.py`. Use 0.0.0.0 behind a reverse proxy.
# HOST=127.0.0.1
PORT=5000
HSK_WALLET_FILE=wallet.json
